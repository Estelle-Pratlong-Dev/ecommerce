{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — {{ shop.name }}{% endblock %}

{% block body %}
    <div class="form-card">
        <h1 style="margin-top:0;">Mot de passe oublié</h1>
        <p style="color:#64748b;">Indiquez votre e-mail : nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

        {{ form_start(requestForm) }}
            <div class="form-row">
                {{ form_label(requestForm.email) }}
                {{ form_widget(requestForm.email) }}
                {{ form_errors(requestForm.email) }}
            </div>
            <button class="btn" type="submit" style="width:100%;">Envoyer le lien</button>
        {{ form_end(requestForm) }}

        <p style="margin-top:1.5rem; text-align:center;">
            <a href="{{ path('app_login') }}">Retour à la connexion</a>
        </p>
    </div>
{% endblock %}
