{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — {{ shop.name }}{% endblock %}

{% block body %}
    <div class="form-card">
        <h1 style="margin-top:0;">Nouveau mot de passe</h1>
        <p style="color:#64748b;">Choisissez un nouveau mot de passe pour votre compte.</p>

        {{ form_start(resetForm) }}
            <div class="form-row">
                {{ form_label(resetForm.plainPassword.first) }}
                {{ form_widget(resetForm.plainPassword.first) }}
                {{ form_errors(resetForm.plainPassword.first) }}
            </div>
            <div class="form-row">
                {{ form_label(resetForm.plainPassword.second) }}
                {{ form_widget(resetForm.plainPassword.second) }}
                {{ form_errors(resetForm.plainPassword.second) }}
            </div>
            <button class="btn" type="submit" style="width:100%;">Réinitialiser mon mot de passe</button>
        {{ form_end(resetForm) }}
    </div>
{% endblock %}
