{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:22px;">Nouvelle commande 🎉</h1>
    <p style="margin:0 0 8px; line-height:1.6;">
        Commande <strong>{{ order.reference }}</strong> passée le {{ order.createdAt|date('d/m/Y à H:i') }}.
    </p>
    <p style="margin:0 0 8px; line-height:1.6;">
        <strong>Client :</strong> {{ order.customer.fullName }} ({{ order.customer.email }})<br>
        {% if order.customer.phone %}<strong>Téléphone :</strong> {{ order.customer.phone }}<br>{% endif %}
    </p>

    {% include 'emails/_order_items.html.twig' %}

    {% if order.shippingAddress %}
        <p style="margin:16px 0 4px; font-weight:bold;">Adresse de livraison</p>
        <p style="margin:0; line-height:1.6; color:#475569;">{{ order.shippingAddress|nl2br }}</p>
    {% endif %}
{% endblock %}
