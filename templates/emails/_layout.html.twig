<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"></head>
<body style="margin:0; padding:0; background:#f1f5f9; font-family:Arial, Helvetica, sans-serif; color:#1e293b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; overflow:hidden;">
                    <tr>
                        <td style="background:{{ shop.theme.secondary }}; padding:22px; text-align:center;">
                            <span style="color:#ffffff; font-size:22px; font-weight:bold;">{{ shop.name }}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px 28px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:20px 28px; border-top:1px solid #e2e8f0; text-align:center; color:#64748b; font-size:12px; line-height:1.6;">
                            {{ shop.name }} — {{ shop.address.zipcode }} {{ shop.address.city }}<br>
                            <a href="mailto:{{ shop.email }}" style="color:{{ shop.theme.primary }};">{{ shop.email }}</a> · {{ shop.phone }}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
