{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:22px;">Merci pour votre commande !</h1>
    <p style="margin:0 0 8px; line-height:1.6;">
        Bonjour {{ order.customer.firstName|default('') }},<br>
        Nous avons bien reçu votre commande <strong>{{ order.reference }}</strong> du {{ order.createdAt|date('d/m/Y') }}.
        Elle est en cours de préparation.
    </p>

    {% include 'emails/_order_items.html.twig' %}

    {% if order.shippingAddress %}
        <p style="margin:16px 0 4px; font-weight:bold;">Adresse de livraison</p>
        <p style="margin:0; line-height:1.6; color:#475569;">{{ order.shippingAddress|nl2br }}</p>
    {% endif %}

    <p style="margin:24px 0 0; line-height:1.6;">
        Vous pouvez suivre votre commande depuis votre espace client.<br>
        À très bientôt,<br>
        <strong>L'équipe {{ shop.name }}</strong>
    </p>
{% endblock %}
