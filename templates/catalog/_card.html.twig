<article class="product-card">
    <a href="{{ path('app_product', { slug: product.slug }) }}" class="thumb">
        {% if product.mainImage %}
            <img src="{{ asset(product.mainImage.path) }}" alt="{{ product.mainImage.alt|default(product.name) }}">
        {% else %}
            <span class="placeholder">🛍️</span>
        {% endif %}
    </a>
    <div class="body">
        {% if product.featured %}<span class="badge">Coup de cœur</span>{% endif %}
        <h3><a href="{{ path('app_product', { slug: product.slug }) }}">{{ product.name }}</a></h3>
        <div class="price">{{ product.priceCents|price }}</div>
        {% if not product.inStock %}
            <small style="color:#991b1b;">Rupture de stock</small>
        {% endif %}
    </div>
</article>
