{% extends 'base.html.twig' %}

{% block title %}{{ shop.name }} — {{ shop.slogan }}{% endblock %}

{% block hero %}
    <section class="hero">
        <div class="hero-inner">
            <div class="eyebrow">La boutique</div>
            <h1>{{ shop.name }}</h1>
            {% if shop.slogan %}<p>{{ shop.slogan }}</p>{% endif %}
            <a href="{{ path('app_catalog') }}" class="link-cta">Découvrir la boutique →</a>
        </div>
    </section>
{% endblock %}

{% block body %}
    <section>
        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:1rem;">
            <h2 class="section-title" style="margin-bottom:0;">Nos produits phares</h2>
            <a href="{{ path('app_catalog') }}" class="btn-ghost">Tout voir</a>
        </div>
        <div style="height:2rem;"></div>

        {% if featured is empty %}
            <p>Aucun produit pour le moment. Ajoute-en depuis l'espace d'administration !</p>
        {% else %}
            <div class="product-grid">
                {% for product in featured %}
                    {% include 'catalog/_card.html.twig' with { product: product } %}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}

{% block outro %}
    <section class="trust">
        <div class="trust-inner">
            <div class="trust-item"><b>Livraison rapide</b><small>Expédié avec soin</small></div>
            <div class="trust-item"><b>Paiement sécurisé</b><small>Carte bancaire via Stripe</small></div>
            <div class="trust-item"><b>Retours {{ shop.legal.return_days }} jours</b><small>Satisfait ou remboursé</small></div>
        </div>
    </section>
{% endblock %}
