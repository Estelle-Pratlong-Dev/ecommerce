{% extends 'base.html.twig' %}

{% block title %}Contact — {{ shop.name }}{% endblock %}

{% block body %}
    <h1 class="section-title">Nous contacter</h1>

    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:3rem;">
        <div>
            <h3>{{ shop.name }}</h3>
            <p>{{ shop.description }}</p>
            <p>
                <strong>Adresse</strong><br>
                {{ shop.address.street }}<br>
                {{ shop.address.zipcode }} {{ shop.address.city }}<br>
                {{ shop.address.country }}
            </p>
            <p>
                <strong>Email :</strong> <a href="mailto:{{ shop.email }}">{{ shop.email }}</a><br>
                <strong>Téléphone :</strong> {{ shop.phone }}
            </p>
        </div>

        <div class="form-card" style="margin:0; max-width:none;">
            <h3 style="margin-top:0;">Envoyez-nous un message</h3>

            {{ form_start(contactForm) }}
                <div class="form-row">
                    {{ form_label(contactForm.name) }}
                    {{ form_widget(contactForm.name) }}
                    {{ form_errors(contactForm.name) }}
                </div>
                <div class="form-row">
                    {{ form_label(contactForm.email) }}
                    {{ form_widget(contactForm.email) }}
                    {{ form_errors(contactForm.email) }}
                </div>
                <div class="form-row">
                    {{ form_label(contactForm.subject) }}
                    {{ form_widget(contactForm.subject) }}
                    {{ form_errors(contactForm.subject) }}
                </div>
                <div class="form-row">
                    {{ form_label(contactForm.message) }}
                    {{ form_widget(contactForm.message, { attr: { rows: 5 } }) }}
                    {{ form_errors(contactForm.message) }}
                </div>
                <button class="btn" type="submit">Envoyer</button>
            {{ form_end(contactForm) }}
        </div>
    </div>
{% endblock %}
