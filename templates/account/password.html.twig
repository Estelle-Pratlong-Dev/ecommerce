{% extends 'base.html.twig' %}

{% block title %}Mot de passe — {{ shop.name }}{% endblock %}

{% block body %}
    <h1 class="section-title">Mon compte</h1>

    {% include 'account/_nav.html.twig' %}

    <div class="form-card" style="margin:0;">
        <h2 style="margin-top:0;">Changer mon mot de passe</h2>

        {{ form_start(passwordForm) }}
            <div class="form-row">
                {{ form_label(passwordForm.currentPassword) }}
                {{ form_widget(passwordForm.currentPassword) }}
                {{ form_errors(passwordForm.currentPassword) }}
            </div>
            <div class="form-row">
                {{ form_label(passwordForm.plainPassword.first) }}
                {{ form_widget(passwordForm.plainPassword.first) }}
                {{ form_errors(passwordForm.plainPassword.first) }}
            </div>
            <div class="form-row">
                {{ form_label(passwordForm.plainPassword.second) }}
                {{ form_widget(passwordForm.plainPassword.second) }}
                {{ form_errors(passwordForm.plainPassword.second) }}
            </div>
            <button class="btn" type="submit">Mettre à jour</button>
        {{ form_end(passwordForm) }}

        <p style="margin-top:1.25rem; color:#64748b;">
            Vous ne connaissez plus votre mot de passe actuel ?
            <a href="{{ path('app_forgot_password') }}">Réinitialisez-le par e-mail</a>.
        </p>
    </div>
{% endblock %}
