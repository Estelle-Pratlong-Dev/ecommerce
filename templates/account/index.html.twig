{% extends 'base.html.twig' %}

{% block title %}Mon compte — {{ shop.name }}{% endblock %}

{% block body %}
    <h1 class="section-title">Bonjour {{ app.user.fullName }}</h1>

    {% include 'account/_nav.html.twig' %}

    <h2>Mes commandes</h2>
    {% if orders is empty %}
        <p>Vous n'avez pas encore passé de commande.</p>
        <a href="{{ path('app_catalog') }}" class="btn">Découvrir la boutique</a>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Référence</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td>{{ order.reference }}</td>
                        <td>{{ order.createdAt|date('d/m/Y') }}</td>
                        <td>{{ order.statusLabel }}</td>
                        <td>{{ order.totalCents|price }}</td>
                        <td><a href="{{ path('app_account_order', { id: order.id }) }}">Voir le détail</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
